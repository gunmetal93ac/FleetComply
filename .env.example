# ── Database ───────────────────────────────────────────────
# Local PostgreSQL (see README → Database setup)
DATABASE_URL="postgresql://fleetcomply:fleetcomply@localhost:5432/fleetcomply?schema=public"

# ── Sessions ───────────────────────────────────────────────
# Set to "true" behind HTTPS (production). Leave false for http://localhost.
COOKIE_SECURE="false"

# ── Document storage ───────────────────────────────────────
# "local" = DEVELOPMENT adapter: AES-256-GCM encrypted files on local disk.
# Production requires an S3-compatible adapter (not implemented in Phase 1).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.data/uploads"
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=""
MAX_UPLOAD_MB="15"

# ── AI assistant (Phase 3 — not used yet) ──────────────────
# ANTHROPIC_API_KEY=""
